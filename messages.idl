//idlc -l c messages.idl

struct JoinRequest
{
	unsigned long long client_token;
};

struct JoinResponse
{
	unsigned long long client_token;
	//IDL needs int width to be clearly defined
    long int_player_id;
};

struct Input
{
	long int_player_id;
    char ch_direction;
};

/* One authoritative snapshot per server tick. Fixed arrays keep the
 * update bounded and let every client render the same players and coins. */
struct GameState
{
	unsigned long tick;
	long phase;
	long time_left;
	long winners;
	long best_score;
	boolean player_active[5];
	long player_x[5];
	long player_y[5];
	long player_score[5];
	boolean coin_active[8];
	boolean coin_gold[8];
	long coin_x[8];
	long coin_y[8];
	long coin_size[8];
};
