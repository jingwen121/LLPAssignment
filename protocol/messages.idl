// Regenerate with: cd build && idlc -l c ../protocol/messages.idl

struct JoinRequest
{
    octet client_id[16];
    unsigned long long client_token;
    long room_code;
    boolean create_room;
    char display_name[17];
};

struct JoinResponse
{
    octet client_id[16];
    unsigned long long client_token;
    long room_code;
    long int_player_id;
    unsigned long long session_id;
};

struct Input
{
    long room_code;
    long int_player_id;
    char ch_direction;
    boolean leave_room;

    // Bind intent to this admission; older sequences cannot be replayed
    unsigned long long seq;
    unsigned long long session_id;
};

/* Room code keys state instances so one room's snapshot cannot replace
 * another room's latest update in DDS history. */
struct GameState
{
    @key long room_code;
    unsigned long long seq;
    unsigned long tick;
    long phase;
    long time_left;
    long winners;
    long best_score;
    long level;
    long ready_players;
    long contenders;
    long danger_lane;
    long bonus_score[5];
    char player_names[5][17];
    boolean player_active[5];
    long player_x[5];
    long player_y[5];
    long player_score[5];
    long player_lives[5]; // Reserved compatibility field; no elimination
    unsigned long player_collect_seq[5];
    unsigned long player_bomb_seq[5];
    boolean coin_active[8];
    boolean coin_gold[8];
    long coin_x[8];
    long coin_y[8];
    long coin_size[8];
    boolean bomb_active[4];
    long bomb_x[4];
    long bomb_y[4];
    long bomb_size[4];
};
